{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "recall-session",
            "type": "command",
            "command": "recall hook session-start --agent gemini-cli",
            "timeout": 15000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "recall-prompt",
            "type": "command",
            "command": "recall hook prompt --agent gemini-cli",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "recall-check",
            "type": "command",
            "command": "recall hook stop --agent gemini-cli",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
